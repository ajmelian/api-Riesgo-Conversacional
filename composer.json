{
    "name": "codesecureforge/risk-api",
    "description": "API de analisis de riesgo conversacional desarrollada con PHP, CodeIgniter 4 y Shield.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-curl": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "codeigniter4/framework": "^4.7",
        "codeigniter4/shield": "^1.3",
        "kint-php/kint": "*"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "league/openapi-psr7-validator": "^0.22",
        "mikey179/vfsstream": "^1.6",
        "mockery/mockery": "^1.6",
        "nyholm/psr7": "^1.8",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "post-update-cmd": [
            "CodeIgniter\\ComposerScripts::postUpdate"
        ],
        "post-install-cmd": [
            "CodeIgniter\\ComposerScripts::postInstall"
        ]
    }
}
