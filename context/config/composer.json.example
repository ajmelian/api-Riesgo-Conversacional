{
  "name": "codesecureforge/risk-api",
  "description": "API de analisis de riesgo conversacional desarrollada con PHP 8.5, CodeIgniter 4 y Shield.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.5",
    "codeigniter4/framework": "^4.7",
    "codeigniter4/shield": "^1.3",
    "ext-json": "*",
    "ext-curl": "*",
    "ext-sodium": "*",
    "ext-pdo_mysql": "*",
    "ext-intl": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0 || ^12.0",
    "fakerphp/faker": "^1.23"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "post-update-cmd": [
      "CodeIgniter\\ComposerScripts::postUpdate"
    ],
    "post-install-cmd": [
      "CodeIgniter\\ComposerScripts::postInstall"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
