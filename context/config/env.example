# Proyecto: API de Analisis de Riesgo Conversacional
# Autor: Aythami Melian Perdomo
# Fecha: 18/06/2026

CI_ENVIRONMENT = production
app.baseURL = 'https://api.example.com/'
app.forceGlobalSecureRequests = true

# Base de datos MySQL/MariaDB
database.default.hostname = localhost
database.default.database = risk_api
database.default.username = risk_api_user
database.default.password = change_me
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

# Seguridad de aplicacion
APP_KEY = change_me_32_bytes_minimum
LLM_TOKEN_ENCRYPTION_KEY = base64:change_me_with_32_random_bytes_base64
SESSION_TTL_SECONDS = 300

# Proveedores LLM permitidos
LLM_ALLOWED_PROVIDERS = openai,anthropic
OPENAI_BASE_URL = https://api.openai.com
ANTHROPIC_BASE_URL = https://api.anthropic.com

# Limites iniciales
API_DEFAULT_RATE_LIMIT_PER_MINUTE = 60
API_DEFAULT_MAX_PAYLOAD_BYTES = 1048576
API_DEFAULT_MAX_MESSAGES = 500
API_DEFAULT_MAX_MESSAGE_LENGTH = 5000

# Logging
LOG_THRESHOLD = 4
LOG_SECRET_REDACTION = true
